#!/usr/bin/env python3

"""Reconcile and build Ateria's display-sized video wallpaper cache."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
from fractions import Fraction
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import time


MANIFEST_VERSION = 3
CACHE_VERSION = 4
MANIFEST_NAME = "manifest.json"
MAX_FRAME_RATE = Fraction(30, 1)
THUMBNAIL_VERSION = 1
THUMBNAIL_WIDTH = 640
HARDWARE_QP = 20
SOFTWARE_CRF = 20
SOFTWARE_PRESET = "medium"


def emit(payload: dict[str, object]) -> None:
    print(json.dumps(payload, separators=(",", ":")), flush=True)


def background_command_prefix() -> list[str]:
    command: list[str] = []
    if shutil.which("nice"):
        command.extend(["nice", "-n", "19"])
    if shutil.which("ionice"):
        command.extend(["ionice", "-c", "3"])
    return command


@contextmanager
def cache_lock(cache_dir: Path):
    cache_dir.mkdir(parents=True, exist_ok=True)
    with (cache_dir / ".lock").open("a+", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        yield


def probe_video(path: Path) -> dict[str, object]:
    result = subprocess.run(
        background_command_prefix() + [
            "ffprobe",
            "-v",
            "error",
            "-select_streams",
            "v:0",
            "-show_entries",
            "stream=width,height,avg_frame_rate,r_frame_rate:format=duration",
            "-of",
            "json",
            str(path),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    payload = json.loads(result.stdout)
    streams = payload.get("streams", [])
    if not streams:
        raise ValueError("no video stream")

    stream = streams[0]
    width = int(stream["width"])
    height = int(stream["height"])
    duration = float(payload.get("format", {}).get("duration", 0) or 0)
    frame_rate = parse_frame_rate(stream.get("avg_frame_rate"), stream.get("r_frame_rate"))
    if width < 1 or height < 1 or duration <= 0:
        raise ValueError("invalid video metadata")

    return {
        "width": width,
        "height": height,
        "duration": duration,
        "frameRate": str(frame_rate),
    }


def parse_frame_rate(*values: object) -> Fraction:
    for value in values:
        try:
            frame_rate = Fraction(str(value))
        except (ValueError, ZeroDivisionError):
            continue
        if frame_rate > 0:
            return frame_rate
    raise ValueError("invalid video frame rate")


def output_frame_rate(source_frame_rate: object) -> Fraction:
    return min(parse_frame_rate(source_frame_rate), MAX_FRAME_RATE)


def target_dimensions(width: int, height: int, max_width: int, max_height: int) -> tuple[int, int]:
    # Wallpapers use PreserveAspectCrop, so retain enough pixels to cover the
    # display in both dimensions before the excess edge is cropped.
    scale = min(1.0, max(max_width / width, max_height / height))
    target_width = max(2, int(width * scale / 2) * 2)
    target_height = max(2, int(height * scale / 2) * 2)
    return target_width, target_height


def cache_identity(
    path: Path,
    stat: os.stat_result,
    width: int,
    height: int,
    frame_rate: object = MAX_FRAME_RATE,
) -> str:
    fields = (
        str(path),
        str(stat.st_size),
        str(stat.st_mtime_ns),
        str(width),
        str(height),
        str(parse_frame_rate(frame_rate)),
        str(CACHE_VERSION),
    )
    digest = hashlib.sha256()
    digest.update("\0".join(fields).encode("utf-8", errors="surrogateescape"))
    return digest.hexdigest()


def thumbnail_identity(path: Path, stat: os.stat_result) -> str:
    fields = (
        str(path),
        str(stat.st_size),
        str(stat.st_mtime_ns),
        str(THUMBNAIL_WIDTH),
        str(THUMBNAIL_VERSION),
    )
    digest = hashlib.sha256()
    digest.update("\0".join(fields).encode("utf-8", errors="surrogateescape"))
    return digest.hexdigest()


def thumbnail_path(cache_dir: Path, source: Path, stat: os.stat_result) -> Path:
    return cache_dir / "thumbnails" / f"{thumbnail_identity(source, stat)}.jpg"


def load_manifest(cache_dir: Path) -> dict[str, object]:
    try:
        payload = json.loads((cache_dir / MANIFEST_NAME).read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return {"version": MANIFEST_VERSION, "entries": {}}
    if payload.get("version") != MANIFEST_VERSION or not isinstance(payload.get("entries"), dict):
        return {"version": MANIFEST_VERSION, "entries": {}}
    return payload


def write_manifest(cache_dir: Path, manifest: dict[str, object]) -> None:
    cache_dir.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix="manifest.", suffix=".tmp", dir=cache_dir)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(manifest, stream, ensure_ascii=False, separators=(",", ":"))
            stream.write("\n")
        os.replace(temporary_name, cache_dir / MANIFEST_NAME)
    except BaseException:
        Path(temporary_name).unlink(missing_ok=True)
        raise


def manifest_metadata(entry: object, stat: os.stat_result) -> dict[str, object] | None:
    if not isinstance(entry, dict):
        return None
    try:
        if int(entry["sourceSize"]) != stat.st_size or int(entry["sourceMtimeNs"]) != stat.st_mtime_ns:
            return None
        width = int(entry["sourceWidth"])
        height = int(entry["sourceHeight"])
        duration = float(entry["duration"])
        frame_rate = parse_frame_rate(entry["sourceFrameRate"])
    except (KeyError, TypeError, ValueError, ZeroDivisionError):
        return None
    if width < 1 or height < 1 or duration <= 0:
        return None
    return {
        "width": width,
        "height": height,
        "duration": duration,
        "frameRate": str(frame_rate),
    }


def stored_entry(
    stat: os.stat_result,
    metadata: dict[str, object],
    target_width: int,
    target_height: int,
    target_frame_rate: Fraction,
    cache_path: Path | None,
    preview_path: Path,
) -> dict[str, object]:
    cache_size = 0
    cache_mtime_ns = 0
    if cache_path is not None:
        try:
            cache_stat = cache_path.stat()
            cache_size = cache_stat.st_size
            cache_mtime_ns = cache_stat.st_mtime_ns
        except OSError:
            pass
    return {
        "sourceSize": stat.st_size,
        "sourceMtimeNs": stat.st_mtime_ns,
        "sourceWidth": int(metadata["width"]),
        "sourceHeight": int(metadata["height"]),
        "duration": float(metadata["duration"]),
        "sourceFrameRate": str(parse_frame_rate(metadata["frameRate"])),
        "targetWidth": target_width,
        "targetHeight": target_height,
        "targetFrameRate": str(target_frame_rate),
        "cachePath": str(cache_path) if cache_path is not None else "",
        "cacheSize": cache_size,
        "cacheMtimeNs": cache_mtime_ns,
        "thumbnailPath": str(preview_path),
    }


def is_nonempty_file(path: Path) -> bool:
    try:
        return path.is_file() and path.stat().st_size > 0
    except OSError:
        return False


def manifest_cache_matches(entry: object, path: Path) -> bool:
    if not isinstance(entry, dict) or str(entry.get("cachePath", "")) != str(path):
        return False
    try:
        stat = path.stat()
        return (
            stat.st_size > 0
            and int(entry["cacheSize"]) == stat.st_size
            and int(entry["cacheMtimeNs"]) == stat.st_mtime_ns
        )
    except (KeyError, OSError, TypeError, ValueError):
        return False


def find_vaapi_device() -> str:
    dri = Path("/dev/dri")
    for device in sorted(dri.glob("renderD*")):
        driver_link = Path("/sys/class/drm") / device.name / "device/driver"
        try:
            driver = driver_link.resolve(strict=True).name
        except OSError:
            continue
        if driver in {"amdgpu", "i915", "xe"}:
            return str(device)
    return ""


def has_vaapi_encoder() -> bool:
    try:
        result = subprocess.run(
            background_command_prefix() + ["ffmpeg", "-hide_banner", "-encoders"],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return False
    return "h264_vaapi" in result.stdout


def validate_cached_video(path: Path, width: int, height: int) -> bool:
    if not path.is_file() or path.stat().st_size <= 0:
        return False
    try:
        metadata = probe_video(path)
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, json.JSONDecodeError):
        return False
    return metadata["width"] == width and metadata["height"] == height


def scan(args: argparse.Namespace) -> int:
    cache_dir = Path(args.cache_dir).expanduser().resolve()
    cache_dir.mkdir(parents=True, exist_ok=True)
    previews_dir = cache_dir / "thumbnails"
    if args.rebuild:
        # Keep the manifest's source metadata. Its size/mtime fingerprint is
        # still validated below, while all generated media is removed and
        # rebuilt. This avoids an unnecessary ffprobe pass over every source.
        for cached_path in cache_dir.glob("*.mp4"):
            cached_path.unlink(missing_ok=True)
        for partial_path in cache_dir.glob("*.partial.*"):
            partial_path.unlink(missing_ok=True)
        if previews_dir.is_dir():
            for preview_path in previews_dir.glob("*.jpg"):
                preview_path.unlink(missing_ok=True)
            for partial_path in previews_dir.glob("*.partial.*"):
                partial_path.unlink(missing_ok=True)

    manifest = load_manifest(cache_dir)
    previous_entries = manifest.get("entries", {})
    assert isinstance(previous_entries, dict)
    new_entries: dict[str, object] = {}
    results: list[dict[str, object]] = []
    retained_paths: set[Path] = set()
    retained_previews: set[Path] = set()

    for source_text in args.sources:
        source = Path(source_text).expanduser().absolute()
        entry: dict[str, object] = {"source": str(source)}
        try:
            stat = source.stat()
            previous_entry = previous_entries.get(str(source))
            metadata = manifest_metadata(previous_entry, stat)
            if metadata is None:
                metadata = probe_video(source)
            source_width = int(metadata["width"])
            source_height = int(metadata["height"])
            source_frame_rate = parse_frame_rate(metadata["frameRate"])
            target_width, target_height = target_dimensions(
                source_width, source_height, args.width, args.height
            )
            requires_transcode = target_width != source_width or target_height != source_height
            target_frame_rate = output_frame_rate(source_frame_rate) if requires_transcode else source_frame_rate
            preview_path = thumbnail_path(cache_dir, source, stat)
            preview_ready = is_nonempty_file(preview_path)
            retained_previews.add(preview_path)
            entry.update(
                {
                    "sourceWidth": source_width,
                    "sourceHeight": source_height,
                    "targetWidth": target_width,
                    "targetHeight": target_height,
                    "duration": metadata["duration"],
                    "sourceFrameRate": str(source_frame_rate),
                    "targetFrameRate": str(target_frame_rate),
                    "thumbnailPath": str(preview_path),
                    "thumbnailStatus": "ready" if preview_ready else "queued",
                }
            )

            if not requires_transcode:
                new_entries[str(source)] = stored_entry(
                    stat,
                    metadata,
                    target_width,
                    target_height,
                    target_frame_rate,
                    None,
                    preview_path,
                )
                entry.update({"status": "original", "playbackPath": str(source), "progress": 1.0})
                results.append(entry)
                continue

            identity = cache_identity(source, stat, target_width, target_height, target_frame_rate)
            cache_path = cache_dir / f"{identity}.mp4"
            entry["cachePath"] = str(cache_path)
            # A matching manifest entry was validated when it was created. Its
            # cheap stat fingerprint avoids probing the cached video again.
            cache_ready = manifest_cache_matches(previous_entry, cache_path)
            if not cache_ready:
                # Adopt an orphaned cache once (for example after manifest
                # recovery), then use the manifest fast path from then on.
                cache_ready = validate_cached_video(cache_path, target_width, target_height)

            if cache_ready:
                retained_paths.add(cache_path)
                entry.update({"status": "ready", "playbackPath": str(cache_path), "progress": 1.0})
            else:
                cache_path.unlink(missing_ok=True)
                entry.update({"status": "queued", "playbackPath": "", "progress": 0.0})
            new_entries[str(source)] = stored_entry(
                stat,
                metadata,
                target_width,
                target_height,
                target_frame_rate,
                cache_path,
                preview_path,
            )
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, json.JSONDecodeError) as error:
            entry.update({"status": "invalid", "playbackPath": "", "progress": 0.0, "error": str(error)})
        results.append(entry)

    # The directory is dedicated to generated wallpaper videos. Only retain
    # files proven to match the current source set and display profile.
    for cached_path in cache_dir.glob("*.mp4"):
        if cached_path not in retained_paths:
            cached_path.unlink(missing_ok=True)
    for partial_path in cache_dir.glob("*.partial.*"):
        partial_path.unlink(missing_ok=True)
    if previews_dir.is_dir():
        for preview_path in previews_dir.glob("*.jpg"):
            if preview_path not in retained_previews:
                preview_path.unlink(missing_ok=True)
        for partial_path in previews_dir.glob("*.partial.*"):
            partial_path.unlink(missing_ok=True)

    manifest = {"version": MANIFEST_VERSION, "entries": new_entries}
    write_manifest(cache_dir, manifest)
    emit(
        {
            "type": "scan",
            "hardwareAvailable": bool(find_vaapi_device() and has_vaapi_encoder()),
            "entries": results,
        }
    )
    return 0


def progress_command(command: list[str], duration: float) -> tuple[int, str]:
    with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as error_stream:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=error_stream,
            text=True,
            bufsize=1,
        )
        assert process.stdout is not None
        last_progress = -1.0
        last_emitted = 0.0
        for raw_line in process.stdout:
            key, separator, value = raw_line.strip().partition("=")
            if not separator or key not in {"out_time_us", "out_time_ms"}:
                continue
            try:
                progress = min(0.99, max(0.0, float(value) / 1_000_000 / duration))
            except ValueError:
                continue
            now = time.monotonic()
            # QML clones the small entry map when progress changes. Cap updates
            # to the display-friendly rate below instead of forwarding every
            # FFmpeg timestamp (which can arrive far faster on hardware).
            if progress > last_progress and (
                last_progress < 0 or progress >= 0.99 or now - last_emitted >= 0.15
            ):
                emit({"type": "progress", "progress": progress})
                last_progress = progress
                last_emitted = now

        exit_code = process.wait()
        error_stream.seek(0)
        return exit_code, error_stream.read().strip()


def transcode(args: argparse.Namespace) -> int:
    source = Path(args.source).expanduser().absolute()
    cache_dir = Path(args.cache_dir).expanduser().resolve()
    cache_dir.mkdir(parents=True, exist_ok=True)
    try:
        stat = source.stat()
        manifest = load_manifest(cache_dir)
        entries = manifest.get("entries", {})
        assert isinstance(entries, dict)
        metadata = manifest_metadata(entries.get(str(source)), stat)
        if metadata is None:
            metadata = probe_video(source)
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, json.JSONDecodeError) as error:
        emit({"type": "error", "message": str(error)})
        return 2

    source_width = int(metadata["width"])
    source_height = int(metadata["height"])
    source_frame_rate = parse_frame_rate(metadata["frameRate"])
    target_frame_rate = output_frame_rate(source_frame_rate)
    target_width, target_height = target_dimensions(source_width, source_height, args.width, args.height)
    identity = cache_identity(source, stat, target_width, target_height, target_frame_rate)
    target_path = cache_dir / f"{identity}.mp4"
    temporary_path = cache_dir / f"{identity}.partial.{os.getpid()}.mp4"
    temporary_path.unlink(missing_ok=True)

    vaapi_device = find_vaapi_device()
    generated = False
    errors: list[str] = []
    if vaapi_device and has_vaapi_encoder():
        emit({"type": "stage", "backend": "vaapi"})
        command = [
            "ffmpeg",
            "-hide_banner",
            "-loglevel",
            "error",
            "-y",
            "-vaapi_device",
            vaapi_device,
            "-hwaccel",
            "vaapi",
            "-hwaccel_device",
            vaapi_device,
            "-hwaccel_output_format",
            "vaapi",
            "-i",
            str(source),
            "-map",
            "0:v:0",
            "-an",
            "-vf",
            f"scale_vaapi=w={target_width}:h={target_height}",
            "-c:v",
            "h264_vaapi",
            "-rc_mode",
            "CQP",
            "-qp",
            str(HARDWARE_QP),
            "-profile:v",
            "high",
        ]
        if source_frame_rate > MAX_FRAME_RATE:
            command.extend(["-r", str(MAX_FRAME_RATE)])
        command.extend(
            [
                "-movflags",
                "+faststart",
                "-stats_period",
                "0.1",
                "-progress",
                "pipe:1",
                "-nostats",
                str(temporary_path),
            ]
        )
        exit_code, error = progress_command(command, float(metadata["duration"]))
        generated = exit_code == 0
        if error:
            errors.append(error)

    if not generated:
        temporary_path.unlink(missing_ok=True)
        emit({"type": "stage", "backend": "software"})
        command = background_command_prefix()
        command.extend(
            [
                "ffmpeg",
                "-hide_banner",
                "-loglevel",
                "error",
                "-y",
                "-i",
                str(source),
                "-map",
                "0:v:0",
                "-an",
                "-vf",
                f"scale={target_width}:{target_height}",
                "-c:v",
                "libx264",
                "-preset",
                SOFTWARE_PRESET,
                "-crf",
                str(SOFTWARE_CRF),
                "-threads",
                "1",
            ]
        )
        if source_frame_rate > MAX_FRAME_RATE:
            command.extend(["-r", str(MAX_FRAME_RATE)])
        command.extend(
            [
                "-pix_fmt",
                "yuv420p",
                "-movflags",
                "+faststart",
                "-stats_period",
                "0.1",
                "-progress",
                "pipe:1",
                "-nostats",
                str(temporary_path),
            ]
        )
        exit_code, error = progress_command(command, float(metadata["duration"]))
        generated = exit_code == 0
        if error:
            errors.append(error)

    if not generated:
        temporary_path.unlink(missing_ok=True)
        emit({"type": "error", "message": errors[-1] if errors else "ffmpeg failed"})
        return 3

    os.replace(temporary_path, target_path)
    manifest = load_manifest(cache_dir)
    entries = manifest.setdefault("entries", {})
    assert isinstance(entries, dict)
    preview_path = thumbnail_path(cache_dir, source, stat)
    entries[str(source)] = stored_entry(
        stat,
        metadata,
        target_width,
        target_height,
        target_frame_rate,
        target_path,
        preview_path,
    )
    write_manifest(cache_dir, manifest)
    emit(
        {
            "type": "ready",
            "playbackPath": str(target_path),
            "targetFrameRate": str(target_frame_rate),
            "progress": 1.0,
        }
    )
    return 0


def generate_thumbnail(args: argparse.Namespace) -> int:
    source = Path(args.source).expanduser().absolute()
    cache_dir = Path(args.cache_dir).expanduser().resolve()
    try:
        stat = source.stat()
    except OSError as error:
        emit({"type": "error", "message": str(error)})
        return 2

    target_path = thumbnail_path(cache_dir, source, stat)
    if is_nonempty_file(target_path):
        emit({"type": "thumbnailReady", "thumbnailPath": str(target_path)})
        return 0

    input_path = source
    if args.input:
        candidate = Path(args.input).expanduser().absolute()
        if is_nonempty_file(candidate):
            input_path = candidate

    target_path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path = target_path.with_name(f"{target_path.stem}.partial.{os.getpid()}.jpg")
    temporary_path.unlink(missing_ok=True)

    command = background_command_prefix()
    command.extend(
        [
            "ffmpeg",
            "-hide_banner",
            "-loglevel",
            "error",
            "-y",
            "-threads",
            "1",
            "-i",
            str(input_path),
            "-map",
            "0:v:0",
            "-an",
            "-frames:v",
            "1",
            "-vf",
            f"scale={THUMBNAIL_WIDTH}:-2:force_original_aspect_ratio=decrease",
            "-q:v",
            "4",
            str(temporary_path),
        ]
    )
    result = subprocess.run(command, check=False, capture_output=True, text=True)
    if result.returncode != 0 or not is_nonempty_file(temporary_path):
        temporary_path.unlink(missing_ok=True)
        message = result.stderr.strip() or "thumbnail generation failed"
        emit({"type": "error", "message": message})
        return 3

    os.replace(temporary_path, target_path)
    emit({"type": "thumbnailReady", "thumbnailPath": str(target_path)})
    return 0


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser()
    subparsers = root.add_subparsers(dest="command", required=True)
    scan_command = subparsers.add_parser("scan")
    scan_command.add_argument("cache_dir")
    scan_command.add_argument("width", type=int)
    scan_command.add_argument("height", type=int)
    scan_command.add_argument("--rebuild", action="store_true")
    scan_command.add_argument("sources", nargs="*")

    transcode_command = subparsers.add_parser("transcode")
    transcode_command.add_argument("cache_dir")
    transcode_command.add_argument("width", type=int)
    transcode_command.add_argument("height", type=int)
    transcode_command.add_argument("source")

    thumbnail_command = subparsers.add_parser("thumbnail")
    thumbnail_command.add_argument("cache_dir")
    thumbnail_command.add_argument("source")
    thumbnail_command.add_argument("input", nargs="?")
    return root


def main() -> int:
    args = parser().parse_args()
    if args.command != "thumbnail" and (args.width < 2 or args.height < 2):
        raise SystemExit("display dimensions must be at least 2x2")
    if args.command != "scan" and (not shutil.which("ffmpeg") or not shutil.which("ffprobe")):
        raise SystemExit("ffmpeg and ffprobe are required")
    with cache_lock(Path(args.cache_dir).expanduser().resolve()):
        if args.command == "scan":
            return scan(args)
        if args.command == "transcode":
            return transcode(args)
        return generate_thumbnail(args)


if __name__ == "__main__":
    raise SystemExit(main())
