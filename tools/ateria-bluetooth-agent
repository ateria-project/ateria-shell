#!/usr/bin/env python3
"""BlueZ pairing agent bridge for Ateria's QML Bluetooth service."""

from __future__ import annotations

import json
import signal
import sys
from typing import Any

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib


BLUEZ_SERVICE = "org.bluez"
AGENT_MANAGER_PATH = "/org/bluez"
AGENT_PATH = "/org/ateria/BluetoothAgent"
AGENT_CAPABILITY = "KeyboardDisplay"


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Canceled(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Canceled"


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, separators=(",", ":")), flush=True)


class PairingAgent(dbus.service.Object):
    def __init__(self, bus: dbus.SystemBus, main_loop: GLib.MainLoop) -> None:
        super().__init__(bus, AGENT_PATH)
        self.bus = bus
        self.main_loop = main_loop
        self.next_request_id = 1
        self.pending: dict[str, Any] | None = None
        GLib.io_add_watch(sys.stdin, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.read_stdin)

    def device_details(self, device_path: str) -> dict[str, str]:
        details = {"path": device_path, "name": "Bluetooth device", "address": ""}
        try:
            proxy = self.bus.get_object(BLUEZ_SERVICE, device_path)
            properties = dbus.Interface(proxy, "org.freedesktop.DBus.Properties")
            values = properties.GetAll("org.bluez.Device1")
            details["name"] = str(values.get("Alias") or values.get("Name") or details["name"])
            details["address"] = str(values.get("Address") or "")
        except dbus.DBusException:
            pass
        return details

    def request(self, request_type: str, device: dbus.ObjectPath, **fields: Any) -> Any:
        if self.pending is not None:
            raise Canceled("Another pairing request is already active")

        request_id = self.next_request_id
        self.next_request_id += 1
        nested_loop = GLib.MainLoop()
        self.pending = {
            "id": request_id,
            "loop": nested_loop,
            "accepted": False,
            "value": None,
            "cancelled": False,
            "timeoutId": 0,
        }
        payload = {
            "event": "request",
            "id": request_id,
            "type": request_type,
            **self.device_details(str(device)),
            **fields,
        }
        emit(payload)

        timeout_id = GLib.timeout_add_seconds(120, self.timeout_pending, request_id)
        self.pending["timeoutId"] = timeout_id
        nested_loop.run()

        response = self.pending
        self.pending = None
        if response is not None and response["timeoutId"]:
            GLib.source_remove(response["timeoutId"])
        if response is None or response["cancelled"]:
            raise Canceled("Pairing was canceled")
        if not response["accepted"]:
            raise Rejected("Pairing was rejected")
        return response["value"]

    def timeout_pending(self, request_id: int) -> bool:
        if self.pending is not None and self.pending["id"] == request_id:
            self.pending["timeoutId"] = 0
            self.pending["cancelled"] = True
            self.pending["loop"].quit()
            emit({"event": "cancelled", "id": request_id, "reason": "timeout"})
        return False

    def read_stdin(self, _stream: Any, condition: GLib.IOCondition) -> bool:
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.main_loop.quit()
            return False

        line = sys.stdin.readline()
        if not line:
            self.main_loop.quit()
            return False
        try:
            message = json.loads(line)
        except (TypeError, ValueError) as error:
            emit({"event": "error", "message": f"Invalid agent response: {error}"})
            return True

        if not isinstance(message, dict):
            emit({"event": "error", "message": "Invalid agent response: expected an object"})
            return True

        pending = self.pending
        try:
            request_id = int(message.get("id", -1))
        except (TypeError, ValueError):
            return True
        if pending is None or request_id != pending["id"]:
            return True
        pending["accepted"] = bool(message.get("accepted", False))
        pending["value"] = message.get("value")
        pending["loop"].quit()
        return True

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self) -> None:
        if self.pending is not None:
            self.pending["cancelled"] = True
            self.pending["loop"].quit()
        emit({"event": "released"})
        self.main_loop.quit()

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device: dbus.ObjectPath) -> str:
        value = str(self.request("pinCode", device) or "")
        if not value:
            raise Rejected("A PIN code is required")
        return value

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device: dbus.ObjectPath, pin_code: str) -> None:
        emit({"event": "display", "type": "pinCode", **self.device_details(str(device)), "value": str(pin_code)})

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device: dbus.ObjectPath) -> dbus.UInt32:
        value = str(self.request("passkey", device) or "")
        if not value.isdigit() or len(value) > 6:
            raise Rejected("The passkey must contain up to six digits")
        return dbus.UInt32(int(value))

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device: dbus.ObjectPath, passkey: int, entered: int) -> None:
        emit({
            "event": "display",
            "type": "passkey",
            **self.device_details(str(device)),
            "value": f"{int(passkey):06d}",
            "entered": int(entered),
        })

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device: dbus.ObjectPath, passkey: int) -> None:
        self.request("confirmation", device, value=f"{int(passkey):06d}")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device: dbus.ObjectPath) -> None:
        self.request("authorization", device)

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device: dbus.ObjectPath, uuid: str) -> None:
        self.request("serviceAuthorization", device, uuid=str(uuid))

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self) -> None:
        if self.pending is not None:
            request_id = self.pending["id"]
            self.pending["cancelled"] = True
            self.pending["loop"].quit()
            emit({"event": "cancelled", "id": request_id, "reason": "bluez"})
        else:
            emit({"event": "cancelled", "reason": "bluez"})


def main() -> int:
    DBusGMainLoop(set_as_default=True)
    main_loop = GLib.MainLoop()
    bus = dbus.SystemBus()
    agent = PairingAgent(bus, main_loop)
    manager = dbus.Interface(bus.get_object(BLUEZ_SERVICE, AGENT_MANAGER_PATH), "org.bluez.AgentManager1")

    try:
        manager.RegisterAgent(AGENT_PATH, AGENT_CAPABILITY)
        manager.RequestDefaultAgent(AGENT_PATH)
    except dbus.DBusException as error:
        emit({"event": "error", "message": f"Could not register Bluetooth agent: {error}"})
        return 1

    emit({"event": "ready"})

    def stop(_signal: int, _frame: Any) -> None:
        if agent.pending is not None:
            agent.pending["cancelled"] = True
            agent.pending["loop"].quit()
        main_loop.quit()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        main_loop.run()
    finally:
        try:
            manager.UnregisterAgent(AGENT_PATH)
        except dbus.DBusException:
            pass
        agent.remove_from_connection()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (dbus.DBusException, OSError) as error:
        emit({"event": "error", "message": str(error)})
        raise SystemExit(1)
