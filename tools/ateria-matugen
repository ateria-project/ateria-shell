#!/usr/bin/env python3
"""Run Matugen with Ateria's XDG-aware paths and reload hooks."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


TOKENS = ("@ATERIA_ROOT@", "@CONFIG_HOME@", "@STATE_HOME@")


def xdg_path(variable: str, fallback: str) -> Path:
    value = os.getenv(variable)
    return Path(value).expanduser().resolve() if value else (Path.home() / fallback).resolve()


def replace_config_argument(arguments: list[str], runtime_config: Path) -> Path:
    for index, argument in enumerate(arguments):
        if argument in {"--config", "-c"}:
            if index + 1 == len(arguments):
                raise ValueError(f"{argument} requires a path")
            source = Path(arguments[index + 1]).expanduser().resolve()
            arguments[index + 1] = str(runtime_config)
            return source
        if argument.startswith("--config="):
            source = Path(argument.partition("=")[2]).expanduser().resolve()
            arguments[index] = f"--config={runtime_config}"
            return source
    raise ValueError("Ateria requires an explicit Matugen --config path")


def toml_fragment(path: Path) -> str:
    return json.dumps(str(path))[1:-1]


def write_runtime_config(source: Path, runtime: Path, config_home: Path, state_home: Path) -> None:
    root = source.parent.parent
    content = source.read_text()
    replacements = {
        "@ATERIA_ROOT@": root,
        "@CONFIG_HOME@": config_home,
        "@STATE_HOME@": state_home,
    }
    for token, path in replacements.items():
        content = content.replace(token, toml_fragment(path))
    if any(token in content for token in TOKENS):
        raise ValueError(f"unresolved path token in {source}")

    encoded = content.encode()
    try:
        if runtime.read_bytes() == encoded:
            return
    except FileNotFoundError:
        pass

    runtime.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{runtime.name}.", dir=runtime.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(encoded)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, runtime)
    finally:
        temporary.unlink(missing_ok=True)


def run_quiet(command: list[str]) -> None:
    if shutil.which(command[0]) is None:
        return
    subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def installed_components(state_home: Path) -> set[str]:
    try:
        state = json.loads((state_home / "ateria/configs.json").read_text())
        components = state.get("components", {})
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return set()
    return set(components) if isinstance(components, dict) else set()


def reload_apps(config_home: Path, state_home: Path) -> None:
    installed = installed_components(state_home)
    if "niri" in installed:
        run_quiet(["niri", "msg", "action", "load-config-file"])
    if "kitty" in installed:
        run_quiet(["pkill", "-SIGUSR1", "kitty"])
    if "foot" in installed:
        foot_colors = config_home / "foot/ateria/apply-colors"
        if foot_colors.is_file():
            run_quiet([sys.executable, str(foot_colors)])

def main() -> int:
    arguments = sys.argv[1:]
    config_home = xdg_path("XDG_CONFIG_HOME", ".config")
    state_home = xdg_path("XDG_STATE_HOME", ".local/state")
    runtime_config = state_home / "ateria/matugen.toml"
    source_config = replace_config_argument(arguments, runtime_config)
    write_runtime_config(source_config, runtime_config, config_home, state_home)

    result = subprocess.run(["matugen", *arguments])
    if result.returncode == 0:
        reload_apps(config_home, state_home)
    return result.returncode


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"ateria-matugen: {error}", file=sys.stderr)
        raise SystemExit(1)
