#!/bin/sh
set -eu

source_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
native_build_dir=${ATERIA_NATIVE_BUILD_DIR:-"$source_root/.build/native"}

if [ "${ATERIA_SKIP_NATIVE_BUILD:-0}" != "1" ]; then
    "$source_root/tools/ateria-native-modules"
fi

# Qt Multimedia announces its FFmpeg backend and can emit verbose decoder
# diagnostics during normal playback. Keep those categories quiet without
# replacing any logging rules supplied by the user.
ateria_ffmpeg_log_rules='qt.multimedia.ffmpeg=false;qt.multimedia.ffmpeg.*=false'
if [ -n "${QT_LOGGING_RULES:-}" ]; then
    export QT_LOGGING_RULES="$QT_LOGGING_RULES;$ateria_ffmpeg_log_rules"
else
    export QT_LOGGING_RULES="$ateria_ffmpeg_log_rules"
fi

native_qml_path="$native_build_dir/qml"
if [ -n "${QML_IMPORT_PATH:-}" ]; then
    export QML_IMPORT_PATH="$native_qml_path:$QML_IMPORT_PATH"
else
    export QML_IMPORT_PATH="$native_qml_path"
fi

# Quickshell is linked against jemalloc. Its default per-thread arenas retain a
# surprising amount of freed memory over a long-lived session, and the shell
# creates hundreds of short-lived QML objects whenever a panel opens or closes.
# Two arenas plus prompt decay keeps RSS substantially lower without affecting
# the shell's modest allocation rate. Respect an explicit user setting.
if [ -z "${MALLOC_CONF:-}" ]; then
    export MALLOC_CONF="narenas:2,background_thread:true,dirty_decay_ms:1000,muzzy_decay_ms:1000"
fi

# Keep Quickshell's configured identity when this checkout is installed as the
# default config. Plain `qs ipc` calls select that identity, so launching the
# same files through `--path` would make existing keybinds target a different
# instance. Fall back to path mode when running an uninstalled checkout.
quickshell_config_root=${XDG_CONFIG_HOME:-"$HOME/.config"}/quickshell
default_config="$quickshell_config_root/default"
if [ -d "$default_config" ]; then
    resolved_default=$(CDPATH= cd -- "$default_config" && pwd -P)
    if [ "$resolved_default" = "$source_root" ]; then
        exec quickshell --config default "$@"
    fi
fi

exec quickshell --path "$source_root" "$@"
