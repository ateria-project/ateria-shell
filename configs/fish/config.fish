# ATERIA MANAGED FILE
# Ateria can replace this file during a preset update. Do not edit this file.
# Put personal Fish settings in user.fish.

if status is-interactive
    set --local ateria_fish_dir (path dirname (status filename))

    # Apply the saved terminal palette when a new Foot terminal starts.
    set --local ateria_foot_colors "$ateria_fish_dir/../foot/ateria/apply-colors"
    if test "$TERM" = foot; and test -r "$ateria_foot_colors"
        command python3 "$ateria_foot_colors" --stdout
    end

    # Refresh wallpaper colors before every prompt. User color overrides are
    # applied afterward and therefore always take precedence.
    function __ateria_refresh_colors --on-event fish_prompt --inherit-variable ateria_fish_dir
        if test -r "$ateria_fish_dir/ateria-colors.fish"
            source "$ateria_fish_dir/ateria-colors.fish"
        end
        if test -r "$ateria_fish_dir/user-colors.fish"
            source "$ateria_fish_dir/user-colors.fish"
        end
    end
    __ateria_refresh_colors

    # Optional interactive tools. Missing commands are skipped quietly.
    command -q starship; and starship init fish | source
    command -q direnv; and direnv hook fish | source
    command -q zoxide; and zoxide init fish --cmd cd | source

    if command -q eza
        alias ls='eza --icons --group-directories-first -1'
    end

    abbr --add lg lazygit
    abbr --add gd 'git diff'
    abbr --add ga 'git add .'
    abbr --add gc 'git commit'
    abbr --add gl 'git log'
    abbr --add gs 'git status'
    abbr --add gp 'git push'
    abbr --add gpl 'git pull'

    abbr --add l ls
    abbr --add ll 'ls -l'
    abbr --add la 'ls -a'
    abbr --add lla 'ls -la'

    # Mark prompt boundaries for terminals with shell integration support.
    function __ateria_mark_prompt_start --on-event fish_prompt
        printf '\e]133;A\e\\'
    end

    # User configuration is loaded last and can override every preset above.
    if test -r "$ateria_fish_dir/user.fish"
        source "$ateria_fish_dir/user.fish"
    end
end
