#!/usr/bin/env python3
# ATERIA MANAGED FILE
# Ateria can replace this file during a preset update. Do not edit this file.
# Put personal Foot settings in ../user.ini.

"""Apply Matugen's saved terminal colors to running terminals."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def state_home() -> Path:
    value = os.getenv("XDG_STATE_HOME")
    return Path(value).expanduser() if value else Path.home() / ".local/state"


def load_sequences() -> bytes:
    path = state_home() / "ateria/foot-sequences"
    try:
        lines = path.read_text(encoding="ascii").splitlines()
    except (FileNotFoundError, OSError, UnicodeError):
        return b""

    output = bytearray()
    for line in lines:
        if not line.startswith(r"\033]") or not line.endswith(r"\033\\"):
            continue
        output.extend(line.replace(r"\033", "\x1b").replace(r"\\", chr(92)).encode("ascii"))
    return bytes(output)


def broadcast(sequences: bytes) -> None:
    try:
        terminals = Path("/dev/pts").iterdir()
    except OSError:
        return

    flags = os.O_WRONLY | os.O_NONBLOCK | os.O_NOCTTY
    for terminal in terminals:
        if not terminal.name.isdigit():
            continue
        try:
            descriptor = os.open(terminal, flags)
            try:
                os.write(descriptor, sequences)
            finally:
                os.close(descriptor)
        except (BlockingIOError, OSError):
            continue


def main() -> None:
    sequences = load_sequences()
    if not sequences:
        return
    if sys.argv[1:] == ["--stdout"]:
        sys.stdout.buffer.write(sequences)
        return
    broadcast(sequences)


if __name__ == "__main__":
    main()
