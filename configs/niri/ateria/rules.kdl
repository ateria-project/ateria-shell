// ATERIA MANAGED FILE
// Ateria can replace this file during a preset update. Do not edit this file.
// Put personal Niri window rules in ../user-config.kdl.

// Ateria application rules.

window-rule {
    match app-id=r#"^kitty$"#

    // Kitty requests blur itself. Do not draw an opaque focus-ring background
    // behind its transparent window.
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^foot(client)?$"#

    // Foot requests blur itself. Do not draw an opaque focus-ring background
    // behind its transparent window.
    draw-border-with-background false
}
