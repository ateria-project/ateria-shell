// Matugen replaces this file after each palette update. Do not edit this file.
// Put personal Niri color settings in ../user-config.kdl.

// Initial colors used before Ateria processes the first wallpaper.

layout {
    background-color "#131317"
    focus-ring {
        active-color "#c2c1ff"
        inactive-color "#918f9a"
        urgent-color "#ffb4ab"
    }
    border {
        active-color "#c2c1ff"
        inactive-color "#918f9a"
        urgent-color "#ffb4ab"
    }
    shadow { color "#00000070"; }
    tab-indicator {
        active-color "#c2c1ff"
        inactive-color "#918f9a"
        urgent-color "#ffb4ab"
    }
    insert-hint { color "#c2c1ff80"; }
}

overview { backdrop-color "#131317"; }

recent-windows {
    highlight {
        active-color "#c2c1ff"
        urgent-color "#ffb4ab"
    }
}
