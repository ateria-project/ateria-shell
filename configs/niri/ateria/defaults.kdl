// ATERIA MANAGED FILE
// Ateria can replace this file during a preset update. Do not edit this file.
// Put personal Niri settings in ../user-config.kdl.

// Portable defaults for the Ateria desktop.

// Keep Quickshell's jemalloc arenas bounded so long-lived shell sessions do not
// accumulate freed pages across the shell's worker threads.

// Prefer the low-power VAAPI path on Intel and AMD render nodes. Qt falls back
// to its normal backend on systems where one is not present.
spawn-at-startup "sh" "-c" "for node in /sys/class/drm/renderD*/device/driver; do [ -e \"$node\" ] || continue; driver=$(readlink -f \"$node\") || continue; driver=${driver##*/}; case \"$driver\" in amdgpu|i915|xe) export QT_FFMPEG_DECODING_HW_DEVICE_TYPES=vaapi QT_FFMPEG_ENCODING_HW_DEVICE_TYPES=vaapi; break;; esac; done; export MALLOC_CONF=\"${MALLOC_CONF:-narenas:2,background_thread:true,dirty_decay_ms:1000,muzzy_decay_ms:1000}\"; exec qs"

input {
    keyboard {
        xkb { }
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
    }

    border {
        off
        width 2
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations { }
