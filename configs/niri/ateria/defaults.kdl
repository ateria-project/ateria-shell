// ATERIA MANAGED FILE
// Ateria can replace this file during a preset update. Do not edit this file.
// Put personal Niri settings in ../user-config.kdl.

// Portable defaults for the Ateria desktop.

// Shared runtime tuning: bounded jemalloc arenas, the low-power VAAPI path, and
// the EGL vendor for the compositor's GPU. The script leaves the system default
// in place when it cannot identify a matching GPU or GLVND driver.
spawn-at-startup "sh" "-c" "f=\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/ateria/ateria-env.sh\"; if [ -r \"$f\" ]; then . \"$f\"; fi; exec qs"

input {
    keyboard {
        xkb { }
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
    }

    border {
        off
        width 2
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations { }
